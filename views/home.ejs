<%- include('partials/header') %>

<h1>Port de plaisance Russell</h1>

<p>
  Application de gestion des réservations de catways (petits appontements
  d'amarrage) pour la capitainerie : catways, réservations et utilisateurs.
</p>

<h2>Connexion</h2>

<% if (locals.error) { %>
  <p class="error"><%= error %></p>
<% } %>

<form action="/login" method="POST">
  <label for="email">Adresse e-mail</label>
  <input type="email" id="email" name="email" required />

  <label for="password">Mot de passe</label>
  <input type="password" id="password" name="password" required />

  <button type="submit">Se connecter</button>
</form>

<p><a href="/api-docs">Consulter la documentation de l'API</a></p>

<%- include('partials/footer') %>